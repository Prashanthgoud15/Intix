# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/intix?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ─── Groq ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Note: The application uses openai/gpt-oss-20b and openai/gpt-oss-120b models via Groq.

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────
MAX_FILE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=25

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20
